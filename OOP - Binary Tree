class node:
    def __init__(self,data):
        self.data = data
        self.right = None
        self.left = None
    
    def calculate_height(self, current_node):
        if current_node == None:
            return -1
        
        left_height = int(self.calculate_height(current_node.left))
        right_height = int(self.calculate_height(current_node.right))
        
        if left_height > right_height:
            return 1 + left_height
        else:
            return 1 + right_height
    
    def is_balanced(self, current_node):
        if current_node == None:
            return 1
        
        left_height = int(self.calculate_height(current_node.left))
        right_height = int(self.calculate_height(current_node.right))
        
        if abs(left_height - right_height) > 1:
            return 0 #False
        else:
            return 1 #True 
