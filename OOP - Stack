class stack():
    def __init__(self, size):
        self.max_size = size - 1
        self.array = [None] * size
        self.top_pointer = -1
    
    def is_full(self):
        return self.top_pointer == self.max_size
    
    def is_empty(self):
        return self.top_pointer == -1
    
    def push(self, item):
        if self.is_full():
            print("The stack is full.")
            return 0
        
        self.top_pointer += 1
        self.array[self.top_pointer] = item
        return 1
    
    def pop(self):
        if self.is_empty():
            print("The stack is empty")
            return 0
      
        self.top_pointer -= 1
        return self.array[self.top_pointer]
