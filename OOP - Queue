#it uses a first in, first out priniple
class queue():
    def __init__(self,size):
        self.max_size = size
        self.queue = [None] * size
        self.back = -1
        self.front = -1
    
    def is_empty(self):
        return self.front == -1
    
    def is_full(self):
        return (self.back + 1) % self.max_size == self.front
    
    def enqueue(self, item):
        try:
            if self.is_full():
                print("The queue is full.")
                return False
         
            if self.is_empty():
                self.front = 0
                self.back = 0
                self.queue[self.back] = item
                return True
        
            self.back = (self.back + 1) % self.max_size
            self.queue[self.back] = item
            return True
        except:
            print("Error!!")
            return False
            
    def dequeue(self):
        try:
            if self.is_empty():
                print("Queue Underflow")
                return False
            
            item = self.queue[self.front]
            
            if self.front == self.back:
                self.front = -1
                self.back = -1
                print("Queue Emptied")
                return item
            else:
                self.front = (self.front + 1) % self.max_size
                return item
            return False
        except:
            print("Error!!")
            return False
